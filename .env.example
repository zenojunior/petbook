# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/petbook

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID,
# type "Web application"). Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where uploaded images are stored on disk (default: ./uploads). In production, point it at a
# mounted volume, e.g. /app/uploads, or the files are lost on every deploy.
UPLOAD_DIR=

# Server-side OpenAI Decisions API moderation. Missing key or API failure sends books to human review.
OPENAI_API_KEY=

# Optional input-token price used for Decisions cost estimates (USD per million).
# Snapshot on each run; changing it does not rewrite historical costs. Default: 0.10.
OPENAI_DECISIONS_INPUT_USD_PER_MILLION=0.10
